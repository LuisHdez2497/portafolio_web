VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ADMIN_EMAIL=

# Opcional: Google Analytics (GA4) en la página pública. Sin él, Analytics queda inactivo.
VITE_FIREBASE_MEASUREMENT_ID=

# Opcional: autotraducción ES→EN del CMS. Sin ella, el botón "Traducir al inglés" queda deshabilitado.
VITE_GOOGLE_TRANSLATE_API_KEY=

# Opcional: notificaciones push (FCM Web Push). Clave pública "Web Push certificates" de
# Firebase Console → Configuración del proyecto → Cloud Messaging. Sin ella, el admin no puede
# activar las notificaciones push.
VITE_FIREBASE_VAPID_KEY=
